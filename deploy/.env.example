# Copy to deploy/.env on the NUC and fill in. deploy/.env is git-ignored; never commit it.

# SA password for the SQL Express container. SQL Server requires 8+ chars with upper, lower, digit and symbol.
SQL_PASSWORD=

# Created once at first startup. Changing them here later has no effect on existing users.
# Passwords need at least 10 chars with upper, lower, digit and symbol (ASP.NET Identity defaults).
MARC_EMAIL=
MARC_PASSWORD=
PIA_EMAIL=
PIA_PASSWORD=

# Token from Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > Install connector.
CLOUDFLARE_TUNNEL_TOKEN=
